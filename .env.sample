# Environment Variables Sample
# Copy this file to .env and fill in the values for your local development

# Required: Application environment
# One of: development, test, production
# Secure by default: an unset APP_ENV means production, so keep this set to
# `development` for local work (enables the /debug route, non-Secure cookies,
# and pretty logs).
APP_ENV=development

# Optional: Database connection URL for tests
# TEST_DATABASE_URL=sqlite::memory:

# Required: Database connection URL
{% if database == "postgresql" %}# PostgreSQL (selected backend):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{crate_name}}
# For SQLite instead:
# DATABASE_URL=sqlite:./{{crate_name}}.db
# For in-memory SQLite (for testing):
# DATABASE_URL=sqlite::memory:{% else %}# For local development with SQLite (default):
# DATABASE_URL=sqlite:./{{crate_name}}.db
# For in-memory SQLite (for testing):
# DATABASE_URL=sqlite::memory:
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/{{crate_name}}
DATABASE_URL=sqlite:./{{crate_name}}.db{% endif %}

# Required: Session key for signing and encrypting cookies
# Generate a secure random key. In production, this should be a long, random string.
SESSION_KEY=use-a-session-key-with-64-bytes-or-more-here-and-store-it-securely

# Optional: Force the Secure flag on session cookies (true/false/1/0)
# Defaults to true in production and false in development/test. Set this to
# override the default, e.g. to test Secure cookies in development.
# SESSION_COOKIE_SECURE=false

# OAuth sign-in providers (selected at generation time). Each provider is
# enabled when BOTH its client ID and secret are set; unset both to disable
# it, or remove a provider entirely by regenerating with the matching
# `oauth_*` option turned off. Setting only one is a startup error.
{% if oauth_github %}# GitHub OAuth — create an OAuth app at https://github.com/settings/developers
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret
# Optional: callback URL override (defaults to http://localhost:8888/... in dev, https://<domain>:<port>/... in production)
# GH_REDIRECT_URI=http://localhost:8888/api/v1/auth/github/callback
{% endif %}{% if oauth_google %}# Google OAuth — create an OAuth client at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:8888/api/v1/auth/google/callback
{% endif %}{% if oauth_facebook %}# Facebook OAuth — create an app at https://developers.facebook.com/apps (add
# the "Facebook Login" product and list the redirect URI under "Valid OAuth
# Redirect URIs")
# FACEBOOK_CLIENT_ID=your_facebook_app_id
# FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
# FACEBOOK_REDIRECT_URI=http://localhost:8888/api/v1/auth/facebook/callback
{% endif %}

# Required: Comma-separated list of allowed CORS origins
# For local development, include your frontend URL(s)
WEB_ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888

# Optional: Port to listen on (defaults to 8888)
PORT=8888

# Optional: Domain name of the application (defaults to "localhost")
DOMAIN_NAME=localhost

# Optional: Trusted proxy IPs/CIDR ranges for X-Forwarded-For header
# Format: Comma-separated list in CIDR notation (e.g., "127.0.0.1/32,::1/128,10.0.0.0/8")
# Defaults to "127.0.0.1/32,::1/128" (localhost) for safety
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional: Maximum number of blocking threads for `spawn_blocking` work
# (leave unset for the Tokio default of 512)
# SERVER_THREADS=512

# Optional: Number of async worker threads for the Tokio runtime
# (leave unset for the default: the number of available CPU cores)
# SERVER_CORE_THREADS=4

# Optional: Set to any value to indicate running in Docker
# DEV_DOCKER=1

# Optional: Set to any value to indicate running on Heroku
# HEROKU=1

{% if metrics %}# Optional: Prometheus metrics access token
# METRICS_TOKEN=your_metrics_token
{% endif %}
{% if sentry %}# Optional: Sentry DSN for error reporting (only active in production)
# SENTRY_DSN=https://public@o0.ingest.sentry.io/0
{% endif %}

# Optional: Logging format
# One of: pretty, full, compact, json (defaults to pretty in dev/test, json in production)
# LOG_FORMAT=pretty

# Storage Configuration
# Optional: Path for local filesystem storage (defaults to "./local_uploads")
# STORAGE_PATH=./local_uploads

# Optional: CDN prefix for generating public URLs (e.g., "cdn.example.com")
# CDN_PREFIX=

# Security: Rate Limiting Configuration
# Format: RATE_LIMITER_{ACTION}_RATE_SECONDS and RATE_LIMITER_{ACTION}_BURST
# Actions: API_REQUEST, LOGIN_ATTEMPT, PASSWORD_RESET, FILE_UPLOAD, FORM_SUBMISSION, OAUTH_AUTHORIZE, OAUTH_CALLBACK, TOKEN_CREATION, PUBLIC_API_READ
# RATE_LIMITER_API_REQUEST_RATE_SECONDS=1
# RATE_LIMITER_API_REQUEST_BURST=10
# RATE_LIMITER_LOGIN_ATTEMPT_RATE_SECONDS=5
# RATE_LIMITER_LOGIN_ATTEMPT_BURST=5
# RATE_LIMITER_PASSWORD_RESET_RATE_SECONDS=60
# RATE_LIMITER_PASSWORD_RESET_BURST=3
# RATE_LIMITER_FILE_UPLOAD_RATE_SECONDS=10
# RATE_LIMITER_FILE_UPLOAD_BURST=5
# RATE_LIMITER_FORM_SUBMISSION_RATE_SECONDS=30
# RATE_LIMITER_FORM_SUBMISSION_BURST=10
# RATE_LIMITER_OAUTH_AUTHORIZE_RATE_SECONDS=5
# RATE_LIMITER_OAUTH_AUTHORIZE_BURST=5
# RATE_LIMITER_OAUTH_CALLBACK_RATE_SECONDS=5
# RATE_LIMITER_OAUTH_CALLBACK_BURST=5
# RATE_LIMITER_TOKEN_CREATION_RATE_SECONDS=10
# RATE_LIMITER_TOKEN_CREATION_BURST=3
# RATE_LIMITER_PUBLIC_API_READ_RATE_SECONDS=1
# RATE_LIMITER_PUBLIC_API_READ_BURST=60

# Security: Blocked IP addresses (comma-separated)
# BLOCKED_IPS=192.168.1.100,10.0.0.50

# Security: Blocked route patterns (comma-separated)
# Matched against axum route templates (MatchedPath), not literal request
# paths — e.g. use /api/v1/posts/{id} to block every post id.
# BLOCKED_ROUTES=/api/admin,/api/internal

# Security: Blocked traffic by headers
# Format: HeaderName=ENV_VAR_NAME,HeaderName2=ENV_VAR_NAME2
# Each ENV_VAR should contain comma-separated values to block
# Values starting and ending with / are treated as regex patterns
# BLOCKED_TRAFFIC=User-Agent=BLOCKED_UAS
# BLOCKED_UAS=/curl\/[\d]+\.[\d]+\.[\d]+/,bad-bot

# Security: Security Headers Configuration
# Enable HSTS (HTTPS only - requires HTTPS to be effective)
# SECURITY_HSTS_ENABLED=false

# HSTS max-age in seconds (default: 31536000 = 1 year)
# SECURITY_HSTS_MAX_AGE=31536000

# HSTS includeSubDomains directive
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true

# HSTS preload directive (for inclusion in browser preload lists)
# SECURITY_HSTS_PRELOAD=false

# Content-Security-Policy mode: strict, permissive, or custom:CSP_STRING
# SECURITY_CSP_MODE=strict

# X-Frame-Options: deny, sameorigin, or allow-from:URL
# SECURITY_FRAME_OPTIONS=deny

# Custom frame ancestors for CSP (overrides frame-ancestors directive)
# SECURITY_FRAME_ANCESTORS=https://trusted-domain.com

# Referrer-Policy: no-referrer, no-referrer-when-downgrade, unsafe-url,
# strict-origin-when-cross-origin, same-origin, strict-origin, origin-when-cross-origin
# SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

# Permissions-Policy: restrictive, permissive, or custom:POLICY_STRING
# SECURITY_PERMISSIONS_POLICY=restrictive
